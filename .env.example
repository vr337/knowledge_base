# ==================== 模型源与缓存配置 ====================
# 模型源：modelscope / huggingface
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=/path/to/modelscope_cache
HF_HOME=/path/to/huggingface_cache

# MinerU 临时文件目录
MD_ROOT_DIR=./temp-files/

# ==================== LLM 大模型配置 ====================
# api_key申请地址：https://bailian.console.aliyun.com/cn-beijing/?tab=model#/api-key
# 大模型文档：https://bailian.console.aliyun.com/cn-beijing/?tab=doc#/doc
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash

# 阿里云百炼 API 配置（兼容 OpenAI 接口）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型温度参数（0.0 ~ 1.0）
LLM_DEFAULT_TEMPERATURE=0.1

# ==================== Embedding 嵌入模型配置 ====================
# BGE-M3 模型路径（本地）
BGE_M3_PATH=/path/to/modelscope_cache/models/BAAI/bge-m3
BGE_M3=BAAI/bge-m3

# 设备：cuda:0 / cpu
# BGE_DEVICE=cuda:0
BGE_DEVICE=cpu

# CPU 上需要关闭 FP16（设为 0），GPU 上可开启（设为 1）
BGE_FP16=0

ITEM_NAME_DIAG=1

# ==================== Milvus 向量数据库配置 ====================
MILVUS_URL=your_milvus_url
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# 向量维度（BGE-M3 为 1024）
EMBEDDING_DIM=1024

# ==================== Neo4j 图数据库配置 ====================
NEO4J_URI=bolt://your_neo4j_host:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ==================== MongoDB 配置 ====================
MONGO_URL=mongodb://your_mongo_host:27017
MONGO_DB_NAME=kb002

# ==================== MinIO 对象存储配置 ====================
MINIO_ENDPOINT=your_minio_endpoint:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ==================== 重排序模型配置 ====================
BGE_RERANKER_LARGE=/path/to/modelscope_cache/models/rerank/BAAI/bge-reranker-large
# BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_DEVICE=cpu
# BGE_RERANKER_FP16=1
BGE_RERANKER_FP16=0

# ==================== MCP 服务配置 ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse

# ==================== MinerU API 配置 ====================
# MinerU API Token（从 https://mineru.net 获取）
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_BASE_URL=https://mineru.net/api/v4

# ==================== 日志配置 ====================
# 控制台日志：True=开启 / False=关闭
LOG_CONSOLE_ENABLE=True
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_CONSOLE_LEVEL=INFO

# 文件日志：True=开启 / False=关闭
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
# 日志文件保留天数
LOG_FILE_RETENTION=7 days