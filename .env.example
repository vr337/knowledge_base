# ==================== 模型源与缓存配置 ====================
# 模型源：modelscope / huggingface
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=/path/to/modelscope_cache
HF_HOME=/path/to/huggingface_cache

# MinerU 临时文件目录
MD_ROOT_DIR=./temp-files/

# ==================== LLM 大模型配置 ====================
# api_key申请地址：https://bailian.console.aliyun.com/cn-beijing/?tab=model#/api-key
# 大模型文档：https://bailian.console.aliyun.com/cn-beijing/?tab=doc#/doc
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash

# 阿里云百炼 API 配置（兼容 OpenAI 接口）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型温度参数（0.0 ~ 1.0）
LLM_DEFAULT_TEMPERATURE=0.1

# ==================== 自建大模型（vLLM）配置 ====================
# 模型调用来源切换：True=自建 vLLM（Qwen3-8B） / False=云端 DashScope（默认）
# 切换为 True 后，get_llm_client() 会改用下方三个 LLM_LOCAL_* 配置，
# 不再读取上方的 OPENAI_API_KEY / OPENAI_BASE_URL / LLM_DEFAULT_MODEL
# 例外：多模态模型（VL_MODEL）仍固定走云端，因为自建 vLLM 未部署 VL 模型
LLM_USE_LOCAL=False
# 自建模型API密钥：必须与 vLLM 启动命令的 --api-key 参数完全一致，否则请求返回 401
# 若 vLLM 启动时未设置 --api-key，则此处填任意非空字符串占位即可
LLM_LOCAL_API_KEY=EMPTY
# 自建模型服务地址：vLLM 的 OpenAI 兼容端点，注意必须带 /v1 后缀
# 本地部署填 http://127.0.0.1:<端口>/v1，端口与 vLLM --port 保持一致
LLM_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# 自建模型名称：必须与 vLLM 启动命令的 --served-model-name 完全一致，否则请求返回 404
LLM_LOCAL_MODEL_NAME=Qwen3-8B

# ==================== Embedding 嵌入模型配置 ====================
# BGE-M3 模型路径（本地）
BGE_M3_PATH=/path/to/modelscope_cache/models/BAAI/bge-m3
BGE_M3=BAAI/bge-m3

# 模型加载方式：True=本地加载模型（默认） / False=调用远端HTTP服务
# 切换为 False 后不再加载本地权重，改走 BGE_M3_HTTP_URL 指向的服务
BGE_M3_USE_LOCAL=True
# 远端BGE-M3服务地址（仅 BGE_M3_USE_LOCAL=False 时生效，不需要带 /v1/embeddings 路径）
BGE_M3_HTTP_URL=http://127.0.0.1:6006

# 设备：cuda:0 / cpu
# BGE_DEVICE=cuda:0
BGE_DEVICE=cpu

# CPU 上需要关闭 FP16（设为 0），GPU 上可开启（设为 1）
BGE_FP16=0

ITEM_NAME_DIAG=1

# ==================== Milvus 向量数据库配置 ====================
MILVUS_URL=your_milvus_url
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# 向量维度（BGE-M3 为 1024）
EMBEDDING_DIM=1024

# ==================== Neo4j 图数据库配置 ====================
NEO4J_URI=bolt://your_neo4j_host:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ==================== MongoDB 配置 ====================
MONGO_URL=mongodb://your_mongo_host:27017
MONGO_DB_NAME=kb002

# ==================== MinIO 对象存储配置 ====================
MINIO_ENDPOINT=your_minio_endpoint:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ==================== 重排序模型配置 ====================
BGE_RERANKER_LARGE=/path/to/modelscope_cache/models/rerank/BAAI/bge-reranker-large
# 模型加载方式：True=本地加载模型（默认） / False=调用远端HTTP服务
# 切换为 False 后不再加载本地权重，改走 BGE_RERANKER_HTTP_URL 指向的服务
BGE_RERANKER_USE_LOCAL=True
# 远端Reranker服务地址（仅 BGE_RERANKER_USE_LOCAL=False 时生效，不需要带 /v1/rerank 路径）
BGE_RERANKER_HTTP_URL=http://127.0.0.1:6008
# BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_DEVICE=cpu
# BGE_RERANKER_FP16=1
BGE_RERANKER_FP16=0

# ==================== MCP 服务配置 ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse

# ==================== MinerU 配置 ====================
# PDF转MD调用方式：True=本地 MinerU 命令行工具（默认，需已安装 mineru 并加入PATH）
#                    False=在线 MinerU API（需配置下方 Token 与 BaseURL）
MINERU_USE_LOCAL=True

# MinerU API Token（从 https://mineru.net 获取，仅 MINERU_USE_LOCAL=False 时生效）
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_BASE_URL=https://mineru.net/api/v4

# ==================== 日志配置 ====================
# 控制台日志：True=开启 / False=关闭
LOG_CONSOLE_ENABLE=True
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_CONSOLE_LEVEL=INFO

# 文件日志：True=开启 / False=关闭
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
# 日志文件保留天数
LOG_FILE_RETENTION=7 days